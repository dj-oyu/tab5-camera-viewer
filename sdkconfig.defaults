# TCP/IP throughput optimization for MJPEG streaming via WireGuard tunnel
# BDP = TCP_WND / RTT. DERP relay RTT ≈ 385ms.
#   TCP_WND=  5,760 → 115 KB/s →  3 fps (ESP-IDF default)
#   TCP_WND= 65,534 → 170 KB/s →  4 fps (16-bit window max)
#   TCP_WND=524,288 → 1.3 MB/s → 35 fps (window scaling, shift=3)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_WND_DEFAULT=524280
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=3
CONFIG_LWIP_TCP_RECVMBOX_SIZE=128

# Bootloader: minimize size to fit within 0x2000-0x8000 (24KB)
# Source-compiled bootloader exceeds 24KB with default log level
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0

# Flash size (Tab5 = 16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
